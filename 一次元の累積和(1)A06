#include<vector>
using namespace std;
#define rep(i,n)for(int i=0;i<(n);++i)

int main(){
    int N,Q;
    cin>>N>>Q;
    vector<int>A(N+1);
    vector<int>L(Q+1);
    vector<int>R(Q+1);

    for(int i=1;i<=N;i++)cin>>A[i];
    for(int i=1;i<=Q;i++)cin>>L[i]>>R[i];

    vector<int>S(N+1,0);
    for(int i=1;i<=N;i++){
        S[i]+=S[i-1]+A[i];
    }
    for(int i=1;i<=Q;i++){
    cout<<S[R[i]]-S[L[i]-1]<<endl;
    }
}
