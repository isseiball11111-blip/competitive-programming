#include<bits/stdc++.h>
#include<vector>
using namespace std;
#define rep(i,n)for(int i=0;i<(n);++i)

int main(){
    int N,Q;
    cin>>N>>Q;
    vector<int>A(N);
    rep(i,N){
        cin>>A[i];
    }
    vector<int>L(Q);
    vector<int>R(Q);
    rep(i,Q)cin>>L[i]>>R[i];

    vector<int> S(N + 1, 0);
    for(int i = 0; i < N; i++){
        S[i + 1] = S[i] + A[i];
    }
    
    for(int i=0;i<Q;i++){
        cout<<S[R[i]]-S[L[i]-1]<<endl;
    }
}
